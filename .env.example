# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application secrets (server only) ---
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored provider credentials unreadable (re-enter them in Settings).
CREDENTIALS_ENCRYPTION_KEY=
# One-time token for creating the first administrator at /setup. Remove after setup if you like.
SETUP_TOKEN=
# Authenticates the background job worker (Vercel Cron sends it automatically).
CRON_SECRET=
# Public URL of the deployment, used in invitation links.
APP_URL=http://localhost:3000
